# Copy to server/.env for local dev. On Railway, set these as service variables
# (see README-railway.md). server/.env is gitignored.

NODE_ENV=development
PORT=8080

# Postgres. Local: a connection string to your own Postgres.
# Railway: reference the Postgres service — ${{ Postgres.DATABASE_URL }}
DATABASE_URL=postgres://user:password@localhost:5432/fitnesshm
# "true" only when using Railway's PUBLIC Postgres URL. Private-network URL: false.
DATABASE_SSL=false

# Browser origin allowed to call the API (localhost origins are always allowed too).
APP_BASE_URL=https://fitnesshm.vercel.app

# --- Step 2: Clerk ---
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# --- Step 4: Strava ---
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_WEBHOOK_VERIFY_TOKEN=
STRAVA_SCOPE=read,activity:read_all
# 32 bytes, base64: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
