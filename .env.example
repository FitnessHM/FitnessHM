# Copy to .env for local dev. .env is gitignored. Read by both Vite
# (VITE_* vars) and the /api functions (via `vercel dev`, or dotenv when a
# script like db:migrate is run directly).

# Local dev origin for the client (CORS allow-list; localhost is always
# allowed too). Mostly moot in prod — frontend and API share one Vercel
# origin there.
APP_BASE_URL=http://localhost:5174

# --- Step 2: Clerk ---
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# --- Neon Postgres ---
# From the Neon dashboard: Project -> Connect. Use the pooled connection
# string. The app talks to it over Neon's WebSocket driver (neon-serverless)
# for real transaction support — see server/src/db/index.ts.
DATABASE_URL=

# --- Step 4: Strava ---
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_WEBHOOK_VERIFY_TOKEN=
STRAVA_SCOPE=read,activity:read_all
# 32 bytes, base64: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
